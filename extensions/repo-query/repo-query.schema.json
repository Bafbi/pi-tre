{
	"$schema": "https://json-schema.org/draft/2020-12/schema#",
	"type": "object",
	"properties": {
		"$schema": {
			"type": "string"
		},
		"defaultModel": {
			"type": "string"
		},
		"models": {
			"type": "object",
			"patternProperties": {
				"^.*$": {
					"type": "string"
				}
			}
		},
		"explorer": {
			"anyOf": [
				{
					"type": "string",
					"const": "auto"
				},
				{
					"type": "string",
					"const": "process"
				}
			]
		}
	},
	"additionalProperties": false
}
