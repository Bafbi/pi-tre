{
	"$schema": "https://json-schema.org/draft/2020-12/schema#",
	"additionalProperties": false,
	"type": "object",
	"properties": {
		"$schema": {
			"type": "string"
		},
		"debug": {
			"default": false,
			"type": "boolean"
		},
		"workspacesRoot": {
			"default": "/home/neudeline/.pi/sillajje",
			"type": "string"
		},
		"subGeneratorModel": {
			"default": "openai/gpt-4o-mini",
			"type": "string"
		},
		"postInit": {
			"default": [],
			"type": "array",
			"items": {
				"type": "string"
			}
		},
		"actions": {
			"default": {},
			"additionalProperties": false,
			"type": "object",
			"properties": {
				"stamp": {
					"default": {},
					"additionalProperties": false,
					"type": "object",
					"properties": {
						"body": {
							"default": [
								"trace",
								"meta",
								"loop",
								"prompt",
								"response"
							],
							"uniqueItems": true,
							"type": "array",
							"items": {
								"anyOf": [
									{
										"const": "trace",
										"type": "string"
									},
									{
										"const": "meta",
										"type": "string"
									},
									{
										"const": "loop",
										"type": "string"
									},
									{
										"const": "prompt",
										"type": "string"
									},
									{
										"const": "response",
										"type": "string"
									}
								]
							}
						},
						"header": {
							"default": {},
							"type": "object",
							"properties": {
								"mode": {
									"default": "one_line",
									"anyOf": [
										{
											"const": "one_line",
											"type": "string"
										},
										{
											"const": "user_prompt",
											"type": "string"
										}
									]
								}
							}
						},
						"trace": {
							"default": {},
							"type": "object",
							"properties": {
								"detail": {
									"default": "high",
									"anyOf": [
										{
											"const": "high",
											"type": "string"
										},
										{
											"const": "step",
											"type": "string"
										},
										{
											"const": "decision",
											"type": "string"
										}
									]
								}
							}
						},
						"loop": {
							"default": [
								"tools",
								"call_count",
								"elapsed",
								"thinking_blocks"
							],
							"uniqueItems": true,
							"type": "array",
							"items": {
								"anyOf": [
									{
										"const": "tools",
										"type": "string"
									},
									{
										"const": "call_count",
										"type": "string"
									},
									{
										"const": "elapsed",
										"type": "string"
									},
									{
										"const": "thinking_blocks",
										"type": "string"
									}
								]
							}
						}
					}
				},
				"fold": {
					"default": {},
					"additionalProperties": false,
					"type": "object",
					"properties": {
						"body": {
							"default": ["summary", "ref"],
							"uniqueItems": true,
							"type": "array",
							"items": {
								"anyOf": [
									{
										"const": "summary",
										"type": "string"
									},
									{
										"const": "ref",
										"type": "string"
									}
								]
							}
						},
						"summary": {
							"default": {},
							"type": "object",
							"properties": {
								"detail": {
									"default": "high",
									"anyOf": [
										{
											"const": "high",
											"type": "string"
										},
										{
											"const": "step",
											"type": "string"
										},
										{
											"const": "decision",
											"type": "string"
										}
									]
								}
							}
						}
					}
				}
			}
		},
		"subGenerator": {
			"default": {},
			"type": "object",
			"properties": {
				"retry": {
					"default": {},
					"type": "object",
					"properties": {
						"maxAttempts": {
							"default": 3,
							"type": "integer"
						}
					}
				},
				"timeoutMs": {
					"default": 30000,
					"type": "integer"
				}
			}
		},
		"vcsGuard": {
			"default": true,
			"type": "boolean"
		}
	}
}
