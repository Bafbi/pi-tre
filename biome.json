{
	"$schema": "https://biomejs.dev/schemas/2.4.12/schema.json",
	"files": {
		"includes": ["**", "!**/.btca", "!**/.vscode", "!**/dist", "!**/node_modules", "!**/.agents", "!**/*-lock.*"]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineWidth": 120
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true
		}
	},
	"assist": { "actions": { "source": { "organizeImports": "on" } } }
}
