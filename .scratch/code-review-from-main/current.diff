       41: // ---------------------------------------------------------------------------
       42: // Path matching
       43: // ---------------------------------------------------------------------------
       44: 
       45: /**
       46:  * Compiled omit globs, keyed by pattern. The budget is read once per action
       47:  * and the pattern list is a handful of entries, so the cache is small and
       48:  * lives for the process.
       49:  */
       50: const GLOB_CACHE = new Map<string, RegExp>();
       51: 
       52: /**
       53:  * Does `path` match any of `patterns`? Patterns use `*` (within a path
       54:  * segment), `**` (across segments), and `?`, anchored to the whole path.
       55:  * `**\/` matches zero or more leading segments, so `**\/*.lock` matches both
       56:  * `yarn.lock` and `vendor/yarn.lock`.
       57:  */
       58: export function matchesOmit(
       59: 	path: string,
       60: 	patterns: readonly string[],
       61: ): boolean {
       62: 	return patterns.some((pattern) => globToRegExp(pattern).test(path));
       63: }
       64: 
       65: function globToRegExp(pattern: string): RegExp {
       66: 	const cached = GLOB_CACHE.get(pattern);
       67: 	if (cached !== undefined) return cached;
       68: 	const regex = compileGlob(pattern);
       69: 	GLOB_CACHE.set(pattern, regex);
       70: 	return regex;
       71: }
       72: 
       73: function compileGlob(pattern: string): RegExp {
       74: 	let source = "^";
       75: 	for (let i = 0; i < pattern.length; i++) {
       76: 		const ch = pattern.charAt(i);
       77: 		if (ch === "*") {
       78: 			if (pattern.charAt(i + 1) === "*") {
       79: 				i++;
       80: 				if (pattern.charAt(i + 1) === "/") {
       81: 					i++;
       82: 					source += "(?:.*/)?";
       83: 				} else {
       84: 					source += ".*";
       85: 				}
       86: 			} else {
       87: 				source += "[^/]*";
       88: 			}
       89: 		} else if (ch === "?") {
       90: 			source += "[^/]";
       91: 		} else if (ch === ".") {
       92: 			source += "\\.";
       93: 		} else if ("\\^$+()[]{}|".includes(ch)) {
       94: 			source += `\\${ch}`;
       95: 		} else {
       96: 			source += ch;
       97: 		}
       98: 	}
       99: 	return new RegExp(`${source}$`);
      100: }
