      165: // ---------------------------------------------------------------------------
      166: // jj reads
      167: // ---------------------------------------------------------------------------
      168: 
      169: /**
      170:  * An exact-match jj fileset for one path: `file:"…"`, with quotes and
      171:  * backslashes escaped. A bare path is a prefix glob, so a name with a glob or
      172:  * complement character would select the wrong files or nothing.
      173:  */
      174: function exactPathFileset(path: string): string {
      175: 	const escaped = path.replace(/\\/g, "\\\\").replace(/"/g, '\\"');
      176: 	return `file:"${escaped}"`;
      177: }
      178: 
      179: /** One file's section of the diff, as jj renders it. */
      180: function fetchFileContent(
      181: 	jj: Jj,
      182: 	spec: DiffSpec,
      183: 	path: string,
      184: 	cwd: string,
      185: ): Promise<string> {
      186: 	// The manifest already carries the range's filesets, so the section is
      187: 	// selected by the file alone. Positional filesets are unioned by jj, so
      188: 	// re-adding the range fileset here would return the whole diff.
      189: 	const fileset = exactPathFileset(path);
      190: 	if ("rev" in spec) return jj.diff(spec.rev, { cwd, filesets: [fileset] });
      191: 	return jj.diffRange(spec.from, spec.to, { cwd, filesets: [fileset] });
      192: }
