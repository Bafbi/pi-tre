      120: // ---------------------------------------------------------------------------
      121: // Rendering
      122: // ---------------------------------------------------------------------------
      123: 
      124: const STATUS_LABELS: Record<DiffFile["status"], string> = {
      125: 	added: "Added",
      126: 	modified: "Modified",
      127: 	removed: "Deleted",
      128: 	renamed: "Renamed",
      129: 	copied: "Copied",
      130: };
      131: 
      132: /** The one-line stand-in a dropped file contributes to the diff text. */
      133: function omittedMarker(file: DiffFile, reason: OmitReason): string {
      134: 	const why =
      135: 		reason === "ignored"
