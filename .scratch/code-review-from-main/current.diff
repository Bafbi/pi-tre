      143: /**
      144:  * Emit one info status when content was dropped. Silent when nothing was:
      145:  * a condensed diff must not look like a healthy one, and a healthy one must
      146:  * not warn.
      147:  */
      148: export function emitDiffCondensed(
      149: 	onStatus: (event: StatusEvent) => void,
      150: 	omitted: readonly OmittedFile[],
      151: ): void {
      152: 	if (omitted.length === 0) return;
      153: 	const shown = omitted.slice(0, 5).map((file) => file.path);
      154: 	const extra =
      155: 		omitted.length > shown.length
      156: 			? `, +${omitted.length - shown.length} more`
      157: 			: "";
