      102: // ---------------------------------------------------------------------------
      103: // Result shapes
      104: // ---------------------------------------------------------------------------
      105: 
      106: /** Why a file's content was left out of the collected diff. */
      107: export type OmitReason = "ignored" | "too-large" | "over-budget";
      108: 
      109: /** A file whose name and change count stayed in the diff, without its content. */
      110: export interface OmittedFile extends DiffFile {
      111: 	reason: OmitReason;
      112: }
      113: 
      114: /** The diff text that reaches the prompt, plus what it left behind. */
      115: export interface CollectedDiff {
      116: 	text: string;
      117: 	omitted: OmittedFile[];
