       29: // Token estimate
       30: // ---------------------------------------------------------------------------
       31: 
       32: /**
       33:  * Estimate a text's token count as one token per four characters. The
       34:  * estimate is deliberately crude: it is hermetic and controllable, and it is
       35:  * used only to bound a prompt, never to bill or to truncate output.
       36:  */
       37: export function estimateTokens(text: string): number {
       38: 	return Math.ceil(text.length / 4);
