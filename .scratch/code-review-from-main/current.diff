      159: 		kind: "info",
      160: 		code: "diff-condensed",
      161: 		message: `diff condensed: ${omitted.length} file${omitted.length === 1 ? "" : "s"} kept by name only (${shown.join(", ")}${extra})`,
      162: 	});
      163: }
