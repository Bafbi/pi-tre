      226: 	const parts: string[] = [];
      227: 	const omitted: OmittedFile[] = [];
      228: 	let tokens = 0;
      229: 	let spent = false;
      230: 	let dropped = 0;
      231: 
      232: 	// A marker carries a full path, so the budget covers markers too. When a
      233: 	// marker does not fit, its file is counted in one trailing line instead.
      234: 	const pushOmitted = (file: DiffFile, reason: OmitReason): void => {
      235: 		omitted.push({ ...file, reason });
      236: 		const marker = omittedMarker(file, reason);
      237: 		const cost = estimateTokens(marker);
      238: 		if (tokens + cost > budget.maxTokens) {
      239: 			dropped += 1;
      240: 			return;
      241: 		}
      242: 		tokens += cost;
      243: 		parts.push(marker);
      244: 	};
      245: 
      246: 	for (const file of files) {
      247: 		const reason = omitReason(file, budget, spent, ignored.has(file.path));
      248: 		if (reason !== undefined) {
      249: 			pushOmitted(file, reason);
      250: 			if (reason === "over-budget") spent = true;
      251: 			continue;
      252: 		}
      253: 
      254: 		const content = await fetchFileContent(jj, spec, file.path, cwd);
      255: 		const cost = estimateTokens(content);
      256: 		if (tokens + cost > budget.maxTokens) {
      257: 			pushOmitted(file, "over-budget");
      258: 			spent = true;
      259: 			continue;
      260: 		}
      261: 		tokens += cost;
      262: 		parts.push(content);
      263: 	}
      264: 
      265: 	if (dropped > 0) {
      266: 		parts.push(
      267: 			`... and ${dropped} more file${dropped === 1 ? "" : "s"} omitted`,
      268: 		);
      269: 	}
      270: 
      271: 	const result = { text: parts.join("\n"), omitted };
      272: 	if (onStatus !== undefined) emitDiffCondensed(onStatus, omitted);
      273: 	return result;
      274: }
